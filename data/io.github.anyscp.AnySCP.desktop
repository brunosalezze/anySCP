[Desktop Entry]
Type=Application
Name=anySCP
GenericName=File Transfer Client
Comment=Transfer files over SFTP, SCP, FTP/FTPS and WebDAV
Exec=anyscp %U
Icon=io.github.anyscp.AnySCP
Terminal=false
