# Libraries conda-forge does not build for linux-aarch64.  They are built
# from source by build-arm64-extras.sh, in the versions (and with the
# options) of conda-forge's linux-64 packages, so both AppImages match.
GTKSOURCEVIEW_VERSION=5.18.0
GTKSOURCEVIEW_SHA256=051a78fe38f793328047e5bcd6d855c6425c0b480c20d9432179e356742c6ac0
VTE_VERSION=0.84.1
VTE_SHA256=aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8
# Container the build runs in (emulated with qemu-user on an x86-64 host).
ARM64_BUILD_IMAGE=arm64v8/ubuntu:22.04
