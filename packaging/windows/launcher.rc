#include <windows.h>

1 ICON "anyscp.ico"
1 RT_MANIFEST "launcher.manifest"

1 VERSIONINFO
FILEVERSION     @VER_COMMA@,0
PRODUCTVERSION  @VER_COMMA@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "anySCP contributors"
      VALUE "FileDescription",  "anySCP - SFTP, SCP, FTP and WebDAV client"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "anySCP"
      VALUE "OriginalFilename", "anySCP.exe"
      VALUE "ProductName",      "anySCP"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
